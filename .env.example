DATABASE_URL=postgresql://app_login:change-me-app@localhost:5432/aqua

MIGRATION_DATABASE_URL=postgresql://aqua:aqua@localhost:5432/aqua

APP_LOGIN_PASSWORD=change-me-app

# BETTER_AUTH_SECRET=...
# BETTER_AUTH_URL=http://localhost:3000

# Parent-page link signing key (C-45). HS256 JWT signed with HS256;
# 7-day TTL; single-purpose scope `parent_view`. Required in
# production (boot-fails otherwise). Generate via:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PARENT_LINK_SECRET=dev-only-replace-in-prod

# Premises QR check-in signing key (V-25). Optional — when unset the
# key is derived from PARENT_LINK_SECRET with a purpose label, so a
# deployment needs no new variable. Set this only to rotate the
# premises QR independently of parent links.
# PREMISES_QR_SECRET=dev-only-replace-in-prod

NODE_ENV=development

# Messaging provider (C-40a). Optional outside production — unset means
# the non-production mock, which records and meters messages but sends
# nothing. In production the default is `disabled` and `mock` is
# refused at boot; the WhatsApp Cloud API adapter (C-40) lands next.
# WHATSAPP_PROVIDER=mock|cloud|disabled

# Cloudflare R2 object store (E-03 audit checkpoints, E-06 activity
# exports). Optional and all-or-nothing: the store is enabled exactly
# when all four are set; with any missing, object writes fail loudly
# rather than half-working. Create an R2 API token with Object Read &
# Write for the bucket. Never commit real values.
# R2_ACCOUNT_ID=...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=aqua

# Audit checkpoint signing key (E-03). HMAC-SHA256 over each
# tenant-day's audit_log rows; the digest is stored in R2 and in an
# always-available platform_audit_log anchor row. The checkpoint job
# and scripts/verify-audit-checkpoint.ts refuse to run without it.
# Generate via:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUDIT_CHECKPOINT_SECRET=...
