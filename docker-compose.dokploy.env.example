# Placeholder environment for the Dokploy Compose deployment.
#
# This file is documentation, not a runtime file: it lists the names
# `docker-compose.dokploy.yml` interpolates and the shape of each value.
# Copy the names into Dokploy → aqua-dev → Docker Compose → Environment
# and replace every <...> placeholder with a real value there. The
# Dokploy Environment editor writes its own .env next to the compose
# file on the VPS; that file is never committed.
#
# Never commit real secrets to this file or any other tracked file.
# Generate values per docs/deployment.md §0c; passwords must be
# URL-safe because they are interpolated raw into connection strings.

# Immutable, exact image tag published by .github/workflows/publish.yml.
# Format: sha-<first 12 chars of the commit>. Never `latest`; rollback
# is setting this back to the previous sha tag.
AQUA_IMAGE_TAG=sha-<12-character-commit-sha>

# Postgres superuser password (Dokploy-managed database service role
# for this compose file). Used by db, migrate.
POSTGRES_PASSWORD=<long-random-url-safe-password>

# app_login role password. MUST equal the password embedded in the
# DATABASE_URL references in the compose file — lib/env.ts refuse to
# boot on drift. Used by migrate, web, worker.
APP_LOGIN_PASSWORD=<long-random-url-safe-password>

# better-auth signing secret (≥32 chars, hex or base64).
BETTER_AUTH_SECRET=<32-byte-hex>

# Public HTTPS origin of the tenant surface — the apex, NOT the ops
# host (the platform WhatsApp login on the ops host reads its own
# host-scoped cookie).
BETTER_AUTH_URL=https://aqua.preprabbit.in

# The platform (ops) host — a bare hostname, no scheme, port or path.
# It is a SIBLING of the apex, not a subdomain of it, so the app
# cannot infer it and Dokploy must be told which host serves /ops/*.
# This must be the exact host you route to `web` for the platform
# domain, and it must differ from the apex host above.
OPS_HOST=aquaops.preprabbit.in

# Parent-page link signing key (HS256, separate from better-auth's).
PARENT_LINK_SECRET=<32-byte-hex>

# Required for scheduled worker export/checkpoint jobs and the manual-only
# backup profile. Set real values in Dokploy's environment before Dev holds
# pilot data. Missing values fail Compose interpolation rather than letting
# jobs retry forever with a disabled object store.
R2_ACCOUNT_ID=<r2-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET=<private-bucket-name>

# Checkpoint HMAC signing key. Do not reuse an auth or R2 secret.
AUDIT_CHECKPOINT_SECRET=<32-byte-hex>

# Hosted WhatsApp mock (capture transport). The mock service runs at
# wa.preprabbit.in and speaks the WhatsApp Cloud API shape, so the app
# POSTs to <WHATSAPP_CAPTURE_URL>/v23.0/<from>/messages. Release 1 has
# no real provider (the Cloud adapter is post-pilot work), so this is
# the only working transport — without it every queued notification
# fails and the ops WhatsApp sign-in cannot deliver a code.
#
# WHATSAPP_PROVIDER=capture requires AQUA_DEPLOYMENT_STAGE=preview;
# the app refuses to boot otherwise. The preview stage also renders an
# honest banner on every page: messages are captured, not delivered.
#
# When a real provider lands, or when the database holds real academy
# records, set WHATSAPP_PROVIDER=disabled and
# AQUA_DEPLOYMENT_STAGE=production in the Dokploy Environment editor.
# See docs/review-fixes-status.md; configure access controls at the
# capture app itself.
WHATSAPP_PROVIDER=capture
AQUA_DEPLOYMENT_STAGE=preview
WHATSAPP_CAPTURE_URL=https://wa.preprabbit.in
# Optional protected gateway/API header (never commit the value):
# WHATSAPP_CAPTURE_AUTH_HEADER=authorization
# WHATSAPP_CAPTURE_AUTH_VALUE=Bearer <secret-configured-at-the-gateway>
