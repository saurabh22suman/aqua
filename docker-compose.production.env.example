# Placeholder names for the separate Production Dokploy Compose project.
# Set real values ONLY in the Production Dokploy environment; never copy
# Dev database or signing secrets into Production. Deployment still waits
# for human review, the release gate, live backup/restore and role checks.
AQUA_IMAGE_DIGEST=sha256:<64-hex-digest-of-approved-published-tag>
POSTGRES_PASSWORD=<production-url-safe-password>
APP_LOGIN_PASSWORD=<production-url-safe-password>
BETTER_AUTH_SECRET=<production-32-byte-hex>
BETTER_AUTH_URL=https://aqua.preprabbit.in
# The platform (ops) host — a bare hostname, no scheme, port or path.
# A sibling of the apex, not a subdomain of it. Must be the exact host
# routed to `web` for the platform domain.
OPS_HOST=aquaops.preprabbit.in
PARENT_LINK_SECRET=<production-32-byte-hex>
R2_ACCOUNT_ID=<production-r2-account-id>
R2_ACCESS_KEY_ID=<production-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<production-r2-secret-access-key>
R2_BUCKET=<private-production-bucket>
AUDIT_CHECKPOINT_SECRET=<production-32-byte-hex>
# Hosted WhatsApp mock (capture transport) at wa.preprabbit.in.
# WHATSAPP_PROVIDER=capture requires AQUA_DEPLOYMENT_STAGE=preview.
# Set both to `disabled` / `production` once a real provider lands or
# the database holds real academy records.
WHATSAPP_PROVIDER=capture
AQUA_DEPLOYMENT_STAGE=preview
WHATSAPP_CAPTURE_URL=https://wa.preprabbit.in
# Optional protected gateway/API header (never commit the value):
# WHATSAPP_CAPTURE_AUTH_HEADER=authorization
# WHATSAPP_CAPTURE_AUTH_VALUE=Bearer <secret-configured-at-the-gateway>
