# Placeholder environment for the STAGING Compose deployment.
#
# This file is documentation, not a runtime file: it lists the names
# `docker-compose.staging.yml` interpolates and the shape of each value.
# It contains NO real credential and no real host — every value below is
# a placeholder. Copy the names into Dokploy → the staging service →
# Docker Compose → Environment and replace every <...> placeholder with a
# real value there. Dokploy writes its own .env next to the compose file
# on the VPS; that file is never committed.
#
# Never commit a real secret to this file or any other tracked file.
# Generate values per docs/deployment.md §0c; passwords must be
# URL-safe because they are interpolated raw into connection strings.
#
# Staging is a separate Compose project on the same host as Dev
# (project sportsip-staging, volume sportsip-staging-pgdata, network
# sportsip-staging-internal). Nothing here may be a Dev or Production
# value: reusing a Dev host, secret or database volume would point a
# preview deployment at live data.

# Immutable, exact image tag published by .github/workflows/publish.yml.
# Format: sha-<first 12 chars of the commit>. Never `latest`; rollback
# is setting this back to the previous sha tag. The staging deployment
# runs the SAME image as Dev — a staging preview of a different build
# proves nothing.
AQUA_IMAGE_TAG=<published-image-tag-sha-000000000000>

# Postgres superuser password for THIS deployment. Used by db, migrate
# and the manual backup profile.
POSTGRES_PASSWORD=<long-random-url-safe-password>

# app_login role password. MUST equal the password embedded in the
# DATABASE_URL references in the compose file — lib/env.ts refuses to
# boot on drift. Used by migrate, web, worker. Generate a different one
# from the Dev deployment's: these are different databases.
APP_LOGIN_PASSWORD=<long-random-url-safe-password>

# better-auth signing secret (>=32 chars, hex or base64). A staging
# secret must differ from Dev's: sharing it would let a staging session
# be replayed against a Dev host.
BETTER_AUTH_SECRET=<32-byte-hex>

# Public HTTPS origin of the STAGING tenant surface — the apex, NOT the
# ops host (the platform WhatsApp login on the ops host reads its own
# host-scoped cookie). Use a host that does not resolve in public DNS
# until the environment is ready.
BETTER_AUTH_URL=<https://staging-apex.invalid>

# The platform (ops) host for staging — a bare hostname, no scheme, port
# or path. It is a SIBLING of the staging apex, not a subdomain of it,
# so the app cannot infer it and Dokploy must be told which host serves
# /ops/*. It must differ from the apex host above, and it must not be
# any other environment's ops host.
OPS_HOST=<staging-ops.invalid>

# The env operator door — the platform (ops) sign-in that does not
# depend on a phone number, a WhatsApp message or an authenticator app.
# When BOTH are set, db/platform-auth.ts routes the platform login to
# db/platform-auth-env.ts: the email and password are compared in
# constant time and the session is created fully authenticated (no TOTP).
# Remove both to fall back to the database credential + TOTP path.
#
# Both or neither: lib/env.ts refuses to boot when only one is set, and
# the password must be at least 12 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
OPS_EMAIL=<staging-operator@invalid>
OPS_PASSWORD=<long-random-password-at-least-12-characters>

# Parent-page link signing key (HS256, separate from better-auth's).
PARENT_LINK_SECRET=<32-byte-hex>

# Required for scheduled worker export/checkpoint jobs and the manual-only
# backup profile. Set real values in Dokploy's environment before staging
# holds any data. Missing values fail Compose interpolation rather than
# letting jobs retry forever with a disabled object store.
R2_ACCOUNT_ID=<r2-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET=<private-bucket-name>

# Checkpoint HMAC signing key. Do not reuse an auth or R2 secret.
AUDIT_CHECKPOINT_SECRET=<32-byte-hex>

# Mocked messaging only. `capture` speaks the WhatsApp Cloud API shape
# against a mock origin, so no message is ever delivered to a real
# person, and `preview` makes the app render an honest banner on every
# page ("messages are captured, not delivered").
#
# WHATSAPP_CAPTURE_URL is REQUIRED in the staging compose file (it has no
# default), so this deployment cannot capture into another environment's
# mock inbox by accident.
#
# The approved existing mock (https://wa.preprabbit.in) MAY be reused here
# for the SYNTHETIC DEMO ONLY — the Splash Sports Club data below, where
# every name, phone and amount is invented. Point it at that mock only
# while the staging database holds synthetic demo data; never leave it
# there once the database holds a real academy's records.
#
# Prefer a dedicated staging capture origin when one exists. The shared
# mock inbox is not partitioned per deployment, so a preview's messages
# land beside another environment's.
WHATSAPP_PROVIDER=capture
AQUA_DEPLOYMENT_STAGE=preview
WHATSAPP_CAPTURE_URL=<https://staging-capture.invalid>
# Optional protected gateway/API header (never commit the value):
# WHATSAPP_CAPTURE_AUTH_HEADER=authorization
# WHATSAPP_CAPTURE_AUTH_VALUE=Bearer <secret-configured-at-the-gateway>

# Synthetic demo club for a staging preview. When true, the deploy step
# (migrate) seeds ONE synthetic club: Splash Sports Club — owner, coach,
# receptionist, eight swimmers (two with guardians), one batch, a priced
# monthly plan and a subscription. Nothing real: the names, phones and
# amounts are invented.
#
# The staging database starts empty. SEED_SPLASH_CLUB is how a staging
# demo is populated — a demo reset means re-seeding THIS database, never
# resetting anyone else's.
#
# SEED_SPLASH_CLUB_PIN is the PIN the seeded owner/coach/receptionist
# sign in with (phone + PIN). There is NO default on purpose — a fixed
# credential on a reachable host is a credential everybody can use. Pick
# one, and flip SEED_SPLASH_CLUB back to false once the demo is done
# (the seeded data stays).
SEED_SPLASH_CLUB=false
SEED_SPLASH_CLUB_PIN=<pin-for-the-staging-demo-only>
