{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/instructions.md"
  ],
  "skills": [
    ".agents/skills",
    ".opencode/skills"
  ],
  "watcher": {
    "ignore": [
      ".next/**",
      "db/drizzle/**",
      ".claude/worktrees/**",
      "coverage/**"
    ]
  },
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "pnpm",
          "dlx",
          "@playwright/mcp@0.0.83",
          "--headless",
          "--isolated",
          "--browser",
          "chromium",
          "--output-dir",
          ".playwright-mcp"
        ],
        "timeout": {
          "catalog": 30000,
          "execution": 30000
        }
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "timeout": {
          "catalog": 15000,
          "execution": 15000
        }
      }
    }
  }
}
