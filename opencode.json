{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/instructions.md"],
  "skills": { "paths": [".agents/skills"] },
  "watcher": {
    "ignore": [".next/**", "db/drizzle/**", ".claude/worktrees/**", "coverage/**"]
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "pnpm", "dlx", "@playwright/mcp@0.0.83",
        "--headless", "--isolated", "--browser", "chromium",
        "--output-dir", ".playwright-mcp"
      ],
      "timeout": 30000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "oauth": false,
      "timeout": 15000
    }
  }
}
