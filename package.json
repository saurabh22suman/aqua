{
  "name": "aqua",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "pretest": "tsx db/seed-platform.ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:reset": "tsx db/reset.ts",
    "db:deploy": "tsx db/deploy.ts",
    "db:new-migration": "tsx scripts/new-migration.ts",
    "check:migrations": "tsx scripts/check-migration-naming.ts",
    "worker": "tsx worker/index.ts",
    "seed": "tsx scripts/seed.ts",
    "check:bundle": "tsx scripts/check-bundle-budget.ts",
    "check:fonts": "tsx scripts/check-font-budget.ts",
    "check:lines": "tsx scripts/check-line-count.ts"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.34.0",
    "next": "^15.5.23",
    "pg": "^8.23.0",
    "pg-boss": "^12.28.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/uuid": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
